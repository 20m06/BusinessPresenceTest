# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — secrets never go into the repo.
# Mirror every variable into Vercel's project settings as well.

# Google (Phase 3+)
GOOGLE_MAPS_API_KEY=

# Supabase (Phase 2+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Phase 8)
RESEND_API_KEY=
EMAIL_FROM="Digital Audit <reports@yourdomain.com>"
EMAIL_REPLY_TO=
EMAIL_ENABLED=false

# Booking
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/michaelkosenko456/30min

# Mode: "commercial" (paid upsells) or "pro_bono" (free club framing)
NEXT_PUBLIC_OFFER_MODE=commercial

# Cost + abuse control
DAILY_AUDIT_CAP=50
PER_IP_DAILY_CAP=30
AUDITS_ENABLED=true
# Random string used to anonymize visitor IPs — generate with: openssl rand -hex 32
IP_HASH_SALT=

# Secrets (Phase 5+) — generate with: openssl rand -hex 32
CRON_SECRET=
ADMIN_TOKEN=

# Public
NEXT_PUBLIC_SITE_URL=https://businessvisibilitytest.vercel.app
NEXT_PUBLIC_SITE_NAME="Business Visibility Test"
